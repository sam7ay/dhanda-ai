# Model APIs key (used by chat.py)
SARVAM_API_KEY=

# Sarvam Voice Agents — needed for live calls from Dhanda AI
SARVAM_VA_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=+91XXXXXXXXXX

# Optional: public URL of this server so Sarvam can post results (e.g. an ngrok URL)
PUBLIC_BASE_URL=
DHANDA_WEBHOOK_SECRET=

# Show the one-click demo button (always on when deployed on Vercel)
DHANDA_DEMO=1

# Real test calls on a deployed site (the database there resets, so keep these in env)
# One person per entry, separated by semicolons. Only people who agreed to a test call.
DHANDA_TEST_CONTACTS=Rakesh, 98765 43210; Simran, 91234 56789
# Where calls are handed over when a retailer asks for the owner
DHANDA_OWNER_MOBILE=+91XXXXXXXXXX

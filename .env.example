# Model APIs key (used by chat.py)
SARVAM_API_KEY=

# Sarvam Voice Agents — needed for live calls from Dhanda AI
SARVAM_VA_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=+91XXXXXXXXXX

# Optional: public URL of this server so Sarvam can post results (e.g. an ngrok URL)
PUBLIC_BASE_URL=
DHANDA_WEBHOOK_SECRET=

# Show the one-click demo button (always on when deployed on Vercel)
DHANDA_DEMO=1

# Owner mobiles allowed to place REAL calls (comma separated). Everyone else gets practice runs,
# so strangers who sign up can't spend your Sarvam credits.
DHANDA_LIVE_USERS=+91XXXXXXXXXX
# Signs login cookies. Set a long random value in production.
DHANDA_SESSION_SECRET=
